# Shared osquery payload pin — the single place the bundled osqueryd version
# and its upstream checksums are asserted (RFC-0156 Section 5, Phase 1).
#
# Sourced by:
#   scripts/build-msi.sh                  (kite-collector-osquery MSI)
#   scripts/build-deb-osquery.sh          (kite-collector-osquery deb)
#   scripts/stage-osquery-embed.sh        (go:embed payload for the
#                                          self-contained Windows .exe)
#   .github/workflows/kite-collector.yml  (release job — re-exports the
#                                          scalars into $GITHUB_ENV so the
#                                          goreleaser ldflags template can
#                                          bake the pin into the binary)
#
# Before this file existed each consumer carried its own copy of the version
# and hash constants, which is exactly the silent-drift risk RFC-0156 Section
# 4.2 (BundledDependency) calls out: three assertions of one fact, no checker.
# Update the pin HERE and nowhere else.
#
# 5.15.0 matches the version the e2e sim tracks
# (tests/e2e/osquery/Dockerfile.osquery) and the daily osquery-smoke workflow
# drift-checks against latest, so a needed bump surfaces there first. The
# SHA256s are of the official assets on the osquery GitHub release; a mismatch
# fails every consumer closed rather than shipping an unverified payload (R4).
#
# POSIX-sh assignments only — no arrays, no command substitution, no logic.
# Multi-value entries are space-separated strings the consumers split with
# `read -r -a`.

OSQUERY_VERSION="5.15.0"

# osquery-<version>.msi — harvested by build-msi.sh and stage-osquery-embed.sh.
OSQUERY_MSI_SHA256="9c06dd0b8fbe76129cff5bebc79277044213d5cddccb9ddfe2179606908a817e"
OSQUERY_MSI_URL="https://github.com/osquery/osquery/releases/download/${OSQUERY_VERSION}/osquery-${OSQUERY_VERSION}.msi"

# osquery_<version>-1.linux_amd64.deb — harvested by build-deb-osquery.sh.
OSQUERY_DEB_SHA256="bb20b589037665aab60060d313a10d2d2c0b2e5955e7fba52a2dc88b445eb8cd"
OSQUERY_DEB_URL="https://github.com/osquery/osquery/releases/download/${OSQUERY_VERSION}/osquery_${OSQUERY_VERSION}-1.linux_amd64.deb"

# osquery is dual-licensed Apache-2.0 / GPL-2.0; this records which license the
# redistribution elects, so packaging ships the matching upstream NOTICE text.
OSQUERY_LICENSE_ID="Apache-2.0"

# Fed to the CVE-exposure pipeline so a future osquery CVE surfaces against
# VulnerTrack's own installer fleet (RFC-0156 R15).
OSQUERY_CPE23="cpe:2.3:a:osquery:osquery:${OSQUERY_VERSION}:*:*:*:*:*:*:*"

# Windows-relevant subset of the community packs the official MSI carries; the
# darwin/linux-only packs (osx-attacks, ossec-rootkit, ...) are dropped. Must
# stay in sync with the <File> list in cmd/kite-collector/wix.wxs.
OSQUERY_WINDOWS_PACKS="windows-hardening windows-attacks vuln-management incident-response it-compliance osquery-monitoring"

# Linux-relevant subset the official deb carries (the windows-*/osx-* packs are
# dropped). Must stay in sync with the commented "packs" block in
# packaging/deb/osquery.conf.
OSQUERY_LINUX_PACKS="vuln-management incident-response it-compliance osquery-monitoring ossec-rootkit hardware-monitoring"
