<?xml version="1.0" encoding="UTF-8"?>

<!--
  WiX source for the kite-collector MSI installer, consumed by the
  goreleaser-pro `msi:` block at release time. The MSI complements the
  in-binary Go wizard:

    - Go wizard:   end-user "I downloaded kite-collector.exe and
                   double-clicked it" path. Friendly UI, manual flow.
    - MSI:         enterprise "IT pushes this via Intune/GPO/SCCM" path.
                   Silent install (msiexec /i kite-collector.msi /quiet),
                   automatic Add/Remove Programs registration, automatic
                   service install + start, transactional rollback.

  Both surfaces ultimately install the *same* binary at the *same* path
  and register the *same* Windows service — the divergence is the UX, not
  the artifact on disk.

  GUID discipline:

    - UpgradeCode is FIXED and shared across every kite-collector release.
      Changing it would make new MSIs install side-by-side with old ones
      instead of upgrading them. NEVER change this value.
    - ProductCode is regenerated per build (Id="*") so MajorUpgrade can
      cleanly remove the previous installation before laying down the
      new one.
    - Component GUIDs (CertsDir) are FIXED so the MSI registry-tracking
      of "this MSI created the certs dir" persists across upgrades and
      the dir is only removed on a full uninstall.

  Templating: goreleaser-pro substitutes {{ .Version }} and friends at
  build time. The `.Version` token comes from the git tag.
-->

<!--
  osquery bundling: `wixl -D OSQUERY` builds the kite-collector-osquery
  variant — same product family (same UpgradeCode, so plain and bundle
  installs replace each other instead of fighting over the kite-collector
  service), plus an osqueryd payload harvested from the official osquery
  MSI by scripts/build-msi.sh. Without -D OSQUERY this file compiles to
  the classic collector-only MSI, byte-for-byte the same layout as before.
-->
<?ifdef var.OSQUERY ?>
<?define ProductName = "Kite Collector + osquery" ?>
<?else?>
<?define ProductName = "Kite Collector" ?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="$(var.ProductName)"
      Language="1033"
      Version="{{ .Version }}"
      Manufacturer="VulnerTrack"
      UpgradeCode="19b944d3-493b-4a20-952d-df1c6b0e2fe3">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Description="Continuous asset discovery and OTLP streaming agent"
        Comments="Kite Collector {{ .Version }} ({{ .ShortCommit }})"/>

    <!--
      MajorUpgrade replaces older installations transparently. The MSI
      noticing an older Kite Collector with this same UpgradeCode will
      remove it before installing the new version — operators get a
      one-MSI upgrade story, not "uninstall old, install new" manual
      steps.

      Schedule defaults to afterInstallValidate, which is what we want —
      wixl (msitools) does not implement the Schedule attribute, so it is
      omitted here for portability between full WiX and wixl-based CI.
    -->
    <!--
      AllowSameVersionUpgrades lets the plain and osquery-bundle MSIs
      (which share this UpgradeCode) replace each other at the SAME
      version — without it a same-version cross-grade installs
      side-by-side and the second ServiceInstall for "kite-collector"
      fails mid-install. Side effect on a same-variant reinstall: the
      existing install is removed and relaid, which is harmless.
    -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Kite Collector is already installed."/>

    <!--
      EmbedCab keeps the .cab inside the .msi (single-file artifact for
      enterprise deployment). CompressionLevel is intentionally omitted
      because wixl does not support that attribute; the default
      ("mszip"-equivalent) compression is fine for a ~10 MiB binary.
    -->
    <MediaTemplate EmbedCab="yes"/>

    <Feature Id="ProductFeature" Title="Kite Collector" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="CertsDirComponent"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>

<?ifdef var.OSQUERY ?>
    <!--
      Bundled osquery. A separate Feature so `msiexec ADDLOCAL=ProductFeature`
      can still lay down a collector-only install from the bundle MSI.
    -->
    <Feature Id="OsqueryFeature" Title="osquery (bundled)" Level="1">
      <ComponentRef Id="OsquerydExecutable"/>
      <ComponentRef Id="OsqueryConfig"/>
      <ComponentRef Id="OsqueryFlags"/>
      <ComponentRef Id="OsqueryCerts"/>
      <ComponentRef Id="OsqueryPacks"/>
      <ComponentRef Id="OsqueryDataDirComponent"/>
      <ComponentRef Id="OsqueryLogDirComponent"/>
    </Feature>
<?endif?>

    <!-- Per-machine install layout: Program Files\Kite Collector\ -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Kite Collector">

          <Component Id="MainExecutable" Guid="16af03e6-2e93-4785-a3c9-bcd60c226088" Win64="yes">
            <File
                Id="KiteCollectorExe"
                Name="kite-collector.exe"
                Source="kite-collector.exe"
                KeyPath="yes"/>

            <!--
              ServiceInstall registers the kite-collector service with the
              Windows SCM directly via MSI, instead of relying on the
              binary's own `install` subcommand to do it. Two reasons:

                1. Silent enterprise installs (msiexec /quiet) need the
                   service registered without launching the wizard.
                2. MSI rollback can cleanly remove the service if any
                   subsequent install step fails.

              Arguments mirror what cmd/kite-collector/install.go writes
              for the SCM-registered command line: service run with the
              certs-dir flag pointing at the ProgramData folder. Path
              is hard-coded to the MSI's CERTSDIR property which resolves
              to the ProgramData folder entry below.
            -->
            <ServiceInstall
                Id="KiteCollectorService"
                Name="kite-collector"
                DisplayName="Kite Collector"
                Description="Continuous asset discovery and OTLP streaming agent"
                Type="ownProcess"
                Start="auto"
                ErrorControl="normal"
                Account="LocalSystem"
                Arguments="service run --certs-dir &quot;[CERTSDIR]&quot;"
                Vital="yes"/>

            <!--
              ServiceControl drives lifecycle around install/uninstall:
              start on install, stop on both install (for upgrade-in-place)
              and uninstall, and remove on uninstall. Wait="no" so the
              installer doesn't block on the agent reaching steady state.
            -->
            <ServiceControl
                Id="StartKiteCollectorService"
                Name="kite-collector"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="no"/>
          </Component>

<?ifdef var.OSQUERY ?>
          <!--
            Bundled osquery payload, namespaced under the Kite Collector
            install so it can never collide with a standalone osquery
            install (which owns Program Files\osquery and the "osqueryd"
            service name). Binary layout mirrors the official MSI
            (osqueryd\osqueryd.exe nesting) so upstream docs still map.

            The daemon doubles as an interactive shell for debugging:
              "...\osquery\osqueryd\osqueryd.exe" -S
            so the 24 MB osqueryi.exe is deliberately not shipped.
          -->
          <Directory Id="OSQUERYDIR" Name="osquery">

            <Component Id="OsqueryConfig" Guid="45e75bb9-366c-439e-a1e8-06a461fd0869" Win64="yes">
              <File
                  Id="OsqueryConf"
                  Name="osquery.conf"
                  Source="osquery/osquery.conf"
                  KeyPath="yes"/>
            </Component>

            <Component Id="OsqueryFlags" Guid="3980459a-c6b3-4387-9cca-8faf684b3b8d" Win64="yes">
              <File
                  Id="OsqueryFlagsFile"
                  Name="osquery.flags"
                  Source="osquery/osquery.flags"
                  KeyPath="yes"/>
            </Component>

            <Directory Id="OSQUERYDDIR" Name="osqueryd">
              <Component Id="OsquerydExecutable" Guid="3a5ebf69-3d8d-4edf-bd28-ed6b2dd9b8a1" Win64="yes">
                <File
                    Id="OsquerydExe"
                    Name="osqueryd.exe"
                    Source="osquery/osqueryd/osqueryd.exe"
                    KeyPath="yes"/>

                <!--
                  Machine-wide env var so an osquery-aware collector build can
                  find the bundled daemon's Thrift pipe without configuration
                  (the contract sketched in tests/e2e/osquery/README.md). The
                  pipe name is namespaced for the same reason the service is:
                  standalone osquery defaults to \\.\pipe\osquery.em.
                -->
                <Environment
                    Id="KiteOsquerySocketEnv"
                    Name="KITE_OSQUERY_SOCKET"
                    Value="\\.\pipe\kite-osquery.em"
                    System="yes"
                    Action="set"
                    Part="all"/>

                <!--
                  Path flags (flagfile, config_path, database_path,
                  logger_path, extensions_socket) ride the SCM command line
                  rather than osquery.flags so INSTALLFOLDER/CERTSDIR
                  relocation keeps working: directory properties resolve at
                  install time and, coming after the flagfile flag, they win
                  any conflicting flagfile line. Directory-valued arguments
                  must not end in a trailing backslash before a closing
                  quote (backslash-quote escapes it), hence
                  "[OSQUERYDATADIR]logs" built from the parent property.
                -->
                <ServiceInstall
                    Id="KiteOsquerydService"
                    Name="kite-osqueryd"
                    DisplayName="Kite Collector osquery daemon"
                    Description="Bundled osquery daemon for the Kite Collector agent"
                    Type="ownProcess"
                    Start="auto"
                    ErrorControl="normal"
                    Account="LocalSystem"
                    Arguments="--flagfile=&quot;[OSQUERYDIR]osquery.flags&quot; --config_path=&quot;[OSQUERYDIR]osquery.conf&quot; --database_path=&quot;[OSQUERYDATADIR]osquery.db&quot; --logger_path=&quot;[OSQUERYDATADIR]logs&quot; --extensions_socket=\\.\pipe\kite-osquery.em"
                    Vital="yes"/>

                <ServiceControl
                    Id="StartKiteOsquerydService"
                    Name="kite-osqueryd"
                    Start="install"
                    Stop="both"
                    Remove="uninstall"
                    Wait="no"/>
              </Component>
            </Directory>

            <Directory Id="OSQUERYCERTSDIR" Name="certs">
              <Component Id="OsqueryCerts" Guid="835a49d9-a35b-4263-a33d-d62092fc13b4" Win64="yes">
                <File
                    Id="OsqueryCertsPem"
                    Name="certs.pem"
                    Source="osquery/certs/certs.pem"
                    KeyPath="yes"/>
              </Component>
            </Directory>

            <!--
              Community packs from the official osquery MSI, Windows-relevant
              subset (the darwin/linux-only packs are dropped at staging time
              by scripts/build-msi.sh). All referenced-but-disabled in
              osquery.conf; one component because they only ever ship as a
              set from the same upstream artifact.
            -->
            <Directory Id="OSQUERYPACKSDIR" Name="packs">
              <Component Id="OsqueryPacks" Guid="1347bacb-3fd5-4166-a6fc-48efc10d0c9c" Win64="yes">
                <File Id="PackWindowsHardening" Name="windows-hardening.conf" Source="osquery/packs/windows-hardening.conf" KeyPath="yes"/>
                <File Id="PackWindowsAttacks" Name="windows-attacks.conf" Source="osquery/packs/windows-attacks.conf"/>
                <File Id="PackVulnManagement" Name="vuln-management.conf" Source="osquery/packs/vuln-management.conf"/>
                <File Id="PackIncidentResponse" Name="incident-response.conf" Source="osquery/packs/incident-response.conf"/>
                <File Id="PackItCompliance" Name="it-compliance.conf" Source="osquery/packs/it-compliance.conf"/>
                <File Id="PackOsqueryMonitoring" Name="osquery-monitoring.conf" Source="osquery/packs/osquery-monitoring.conf"/>
              </Component>
            </Directory>

          </Directory>
<?endif?>

          <Component Id="StartMenuShortcut" Guid="4cbfa176-f57e-4682-afcd-a459abdfc28b" Win64="yes">
            <Shortcut
                Id="DashboardShortcut"
                Name="Kite Collector Dashboard"
                Description="Open the Kite Collector configuration dashboard"
                Target="[#KiteCollectorExe]"
                Arguments="dashboard"
                WorkingDirectory="INSTALLFOLDER"/>
            <RegistryValue
                Root="HKCU"
                Key="Software\VulnerTrack\KiteCollector"
                Name="StartMenuShortcut"
                Type="integer"
                Value="1"
                KeyPath="yes"/>
          </Component>

        </Directory>
      </Directory>

      <!--
        ProgramData\kite-collector is the canonical certs / data dir for a
        per-machine install. The path matches installer.DefaultCertsDir
        (system mode) in internal/installer/installer.go, so the dashboard's
        smart-defaults and the MSI's service arguments agree on where to
        look for ca.pem / agent.pem / agent-key.pem.

        ACLs are inherited from ProgramData (CommonAppDataFolder), which
        grants SYSTEM + Administrators full control by default — exactly
        what the service (running as LocalSystem) needs. We previously
        set explicit <Permission> entries here for SYSTEM/Administrators,
        but those are redundant given the parent ACL and wixl does not
        support nested <Permission> inside <CreateFolder>. Keeping the
        bare <CreateFolder/> so the directory is created at install and
        registry-tracked by Windows Installer for uninstall cleanup.
      -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="CERTSDIR" Name="kite-collector">
          <Component Id="CertsDirComponent" Guid="73156730-7394-494e-8607-838ccbe821ac" Win64="yes">
            <CreateFolder/>
            <RegistryValue
                Root="HKLM"
                Key="Software\VulnerTrack\KiteCollector"
                Name="CertsDir"
                Type="string"
                Value="[CERTSDIR]"
                KeyPath="yes"/>
          </Component>

<?ifdef var.OSQUERY ?>
          <!--
            Mutable osquery state (RocksDB database, result/status logs)
            lives under ProgramData with the collector's own data, not
            under Program Files. Same ACL story as CERTSDIR: inherited
            ProgramData ACEs give the LocalSystem service full control
            while non-admin users cannot modify files created here, which
            also satisfies osqueryd's safe-permissions checks.

            Like the certs dir, runtime files created inside are NOT
            tracked by the MSI and survive uninstall by design.
          -->
          <Directory Id="OSQUERYDATADIR" Name="osquery">
            <Component Id="OsqueryDataDirComponent" Guid="11767768-fb72-48e5-b9b7-60c241dc62bb" Win64="yes">
              <CreateFolder/>
              <RegistryValue
                  Root="HKLM"
                  Key="Software\VulnerTrack\KiteCollector"
                  Name="OsqueryDataDir"
                  Type="string"
                  Value="[OSQUERYDATADIR]"
                  KeyPath="yes"/>
            </Component>
            <Directory Id="OSQUERYLOGDIR" Name="logs">
              <Component Id="OsqueryLogDirComponent" Guid="f5ecbed7-2608-4f9d-8f83-a3ffd35a6c97" Win64="yes">
                <CreateFolder/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\VulnerTrack\KiteCollector"
                    Name="OsqueryLogDir"
                    Type="string"
                    Value="[OSQUERYLOGDIR]"
                    KeyPath="yes"/>
              </Component>
            </Directory>
          </Directory>
<?endif?>
        </Directory>
      </Directory>
    </Directory>

    <!--
      Add/Remove Programs metadata — what end users see when they open
      Settings → Apps. Setting ARPPRODUCTICON would also surface the
      tray icon if we ship one; left out for now to keep the WiX
      surface minimal.
    -->
    <Property Id="ARPHELPLINK" Value="https://github.com/VulnerTrack/kite-collector"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VulnerTrack/kite-collector"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
  </Product>
</Wix>
