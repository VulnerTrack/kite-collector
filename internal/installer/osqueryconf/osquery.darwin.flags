# Behavioral flags for the kite-osqueryd launchd job that
# `kite-collector install --with-osquery` registers on macOS.
#
# Installed to: <certs-dir>/osquery/osquery.flags
#               (default /var/lib/kite-collector/osquery/osquery.flags)
#
# PATH FLAGS DO NOT BELONG HERE. --config_path, --database_path,
# --logger_path and --extensions_socket are passed on the launchd job's
# ProgramArguments (after --flagfile, so the command line wins) — that keeps a
# relocated install working. Inspect them with:
#   sudo launchctl print system/kite-osqueryd
#   plutil -p /Library/LaunchDaemons/kite-osqueryd.plist
#
# gflags reads this file line by line; lines starting with '#' are comments.

# Timestamps in UTC so logs correlate with the collector's OTLP stream.
--utc=true

# Keep INFO-level daemon chatter out of the status logs; warnings and errors
# still land in <certs-dir>/osquery/logs.
--logger_min_status=1

# Splay scheduled queries (also set in osquery.conf; flag form covers the
# window before the config is parsed).
--schedule_splay_percent=10

# File-integrity monitoring: the file_events subscriber is DISABLED by
# osquery's own default (--enable_file_events=false), so it is switched on
# here — otherwise configuring file_paths in osquery.conf silently produces
# zero events and the collector's file_events_recent reads 0. With no
# file_paths configured (the shipped default) no watches are armed, so this
# costs nothing at rest. To hard-disable the whole events subsystem:
# --disable_events=true
--enable_file_events=true

# macOS note — Full Disk Access. Anything osqueryd READS from a TCC-protected
# location (Mail, Messages, Safari, Time Machine, other users' home
# directories, the TCC database itself) comes back empty until the operator
# grants Full Disk Access to the osquery.app bundle the pkg installs. TCC
# denials are not errors: the affected tables return fewer rows, so an
# ungranted host looks like a clean one. See docs/macos-osquery.md.
