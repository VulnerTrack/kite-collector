# A self-contained osquery image built from the official apt repo. There is no
# official osquery Docker image, so we install the signed package the same way
# a production host would.
#
# OSQUERY_VERSION pins a specific release for reproducible simulations. Set it
# to "latest" (the daily drift run does) to install whatever the repo currently
# publishes — that's how a breaking osquery release is caught before adoption.
FROM ubuntu:24.04

ARG OSQUERY_VERSION=5.15.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg jq \
    && install -d /etc/apt/keyrings \
    && curl -fsSL https://pkg.osquery.io/deb/pubkey.gpg \
         | gpg --dearmor -o /etc/apt/keyrings/osquery.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/osquery.gpg] https://pkg.osquery.io/deb deb main" \
         > /etc/apt/sources.list.d/osquery.list \
    && apt-get update \
    && if [ "$OSQUERY_VERSION" = "latest" ] || [ -z "$OSQUERY_VERSION" ]; then \
         apt-get install -y --no-install-recommends osquery; \
       else \
         apt-get install -y --no-install-recommends "osquery=${OSQUERY_VERSION}-1.linux"; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# Shared location for the Thrift extensions socket (the surface a client binds
# to). Lives on a compose volume so the probe / a kite runner can reach it from
# a sibling container. /var/kite/watch is the FIM+YARA watch root (also a
# shared volume): files planted there by a sibling container generate inotify
# events inside the daemon, feeding file_events and yara_events.
#
# The fim/ and yara/ subtrees MUST exist before osqueryd starts: the daemon
# resolves file_paths globs to inotify watches at configure time, and a glob
# that matches nothing adds no watch — events for directories created later
# would be lost. The named volume inherits this layout on first mount. The
# two subtrees are deliberately disjoint; see osquery.conf.
RUN mkdir -p /var/osquery /var/kite/watch/fim /var/kite/watch/yara

COPY osquery.conf /etc/osquery/osquery.conf
COPY yara/kite.yar /etc/osquery/yara/kite.yar
COPY probe.sh /usr/local/bin/probe.sh
COPY checks.sh /usr/local/bin/checks.sh
RUN chmod +x /usr/local/bin/probe.sh /usr/local/bin/checks.sh
